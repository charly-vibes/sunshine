
# dulce-de-leche — data files (do not commit)
.ddl/**/*.db
.ddl/**/store/
.ddl/install-log.json
.ddl/doctor-cache.json
.ddl/compatibility-cache.json

# tool data dirs (managed by `ddl init --gates`)
.testaruda/
.pretender/

# wai pipeline run state (machine-local; the artifacts it gates are committed)
.wai/pipeline-runs/
.wai/resources/pipelines/.last-run

# rust build artifacts
/target/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
